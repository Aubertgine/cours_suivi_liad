# Copie ce fichier en « secrets.toml » (même dossier) et remplis-le.
# secrets.toml n'est JAMAIS envoyé sur GitHub (il est dans .gitignore).
# Sur Streamlit Cloud, colle le même contenu dans Settings > Secrets.

[supabase]
url = "https://xxxxxxxxxxxx.supabase.co"
cle = "sb_secret_xxxxxxxxxxxxxxxx"      # clé SECRÈTE (Project Settings > API Keys)

[utilisateurs.pierre-antoine]
nom = "Pierre-Antoine"
role = "prof"
mot_de_passe = "pbkdf2_sha256$..."      # généré avec : python outils/creer_mot_de_passe.py

[utilisateurs.liad]
nom = "Liad"
role = "eleve"
mot_de_passe = "pbkdf2_sha256$..."
